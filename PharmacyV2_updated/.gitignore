# Build output — regenerated by `dotnet build`/`dotnet run`. These folders can
# contain copies of appsettings.json (see obj/**/appsettings.json), so keeping
# them out of source control matters for secrets hygiene, not just tidiness.
bin/
obj/

# IDE / tooling
.vs/
.vscode/
*.user

# User secrets are stored outside the repo by design (see SECURITY.md) — this
# entry is a backstop in case a secrets.json ever ends up inside the project
# folder by mistake.
secrets.json
